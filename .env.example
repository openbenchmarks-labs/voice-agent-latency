# Copy to .env and fill in. Never commit .env.
# NOTE: the harness reads the .env beside this file, at the repo root -- not the
# process working directory, so tools behave the same from any subdirectory.

# ─── Carrier ────────────────────────────────────────────────────────────────
# Plivo is the only carrier: the caller side of every bench call is Plivo XML
# (Speak/GetInput, harness/dialog.py) and the method forbids measuring a vendor
# over its own network.
CARRIER=plivo

# Plivo console -> API keys.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# The Plivo number we call FROM. Without a real number 
# (or verified caller ID on trial accounts) outbound calls 
# queue silently and no call record is ever created.
PLIVO_FROM_NUMBER=

# Set to true while the account is on trial: trial accounts can only dial
# verified destinations and stamp an announcement into the call audio.
PLIVO_ACCOUNT_IS_TRIAL=false

# ─── Public HTTPS base URL ─────────────────────────────────────────────────
# Plivo reaches every webhook through this, and webhook signatures are
# validated against it. No trailing slash; scheme+port must match how the
# harness is actually serving (see harness/serving.py preflight).
PUBLIC_BASE_URL=

# ─── Telnyx AS A VENDOR UNDER TEST ──────────────────────────────────────────
TELNYX_API_KEY=

# ─── Vapi: AS A VENDOR UNDER TEST ───────────────────────────────────────────
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER=

# ─── Retell AI: AS A VENDOR UNDER TEST ──────────────────────────────────────
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_PHONE_NUMBER=

# ─── Bland AI: AS A VENDOR UNDER TEST ───────────────────────────────────────
BLAND_API_KEY=
BLAND_PHONE_NUMBER=

# ─── ElevenLabs: AS A VENDOR UNDER TEST ─────────────────────────────────────
ELEVENLABS_API_KEY=

# ─── Local paths and behaviour ─────────────────────────────────────────────
# Where per-call artifacts are written. One folder per call.
RUNS_DIR=./runs

LOG_LEVEL=INFO

# Safety cap so a scheduler bug cannot run up a phone bill.
MAX_CALLS_PER_RUN=300
